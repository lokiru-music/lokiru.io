---
import Base from '../layouts/Base.astro';
import Scope from '../components/Scope.astro';
import { getCollection } from 'astro:content';

const software = (await getCollection('software')).sort(
  (a, b) => a.data.order - b.data.order
);
const packs = (await getCollection('packs')).sort(
  (a, b) => a.data.order - b.data.order
);

const statusLabel = {
  available: 'Available',
  beta: 'Open beta',
  soon: 'In build',
} as const;

const PACKS_URL = 'https://drews.studio/';
const PARTNER_URL = 'https://msxaudio.com/';
---

<Base
  title="Lokiru — software for people who play"
  description="Lokiru makes small, sharp music software: a polyrhythm metronome, a transcription app for macOS, and Valvetrain, a live performance suite."
>
  <!-- ================= HERO ================= -->
  <section class="hero">
    <div class="weave weave--faint" aria-hidden="true"></div>
    <Scope />

    <div class="wrap hero__in">
      <p class="label label--hot">Lokiru — music software</p>

      <h1 class="display hero__h">
        Tools for<br /><span class="hero__h-alt">people who play.</span>
      </h1>

      <p class="lede hero__lede">
        Small, sharp software for practice, transcription and the stage —{' '}
        <strong>plus a shelf of horn libraries</strong> recorded with MSXII Sound.
      </p>

      <div class="hero__cta">
        <a class="btn btn--solid" href="#software">Browse the rack</a>
        <a class="btn btn--ghost" href="#packs">See the libraries →</a>
      </div>
    </div>
  </section>

  <hr class="thread" />

  <!-- ================= 01 RACK ================= -->
  <section class="section section--alt" id="software">
    <div class="weave" aria-hidden="true"></div>
    <div class="wrap rack__wrap">
      <div class="stage">
        <span class="stage__pos">01</span>
        <span class="stage__name">Rack</span>
        <span class="stage__line" aria-hidden="true"></span>
      </div>

      <div class="head">
        <h2 class="h2">Software</h2>
        <p class="lede">
          Small tools that do one thing hard. One is finished and free to use
          right now; two are still on the bench.
        </p>
      </div>

      <ul class="rack" role="list">
        {software.map((s) => (
          <li class="unit">
            <div class="unit__id">
              <p class="label">{s.data.kind}</p>
              <h3 class="unit__title">{s.data.title}</h3>
            </div>

            <div class="unit__mid">
              <p class="unit__blurb">{s.data.blurb}</p>
              {s.data.modules.length > 0 && (
                <ul class="modules" role="list">
                  {s.data.modules.map((m) => <li>{m}</li>)}
                </ul>
              )}
            </div>

            <div class="unit__specs">
              <ul class="chips" role="list">
                {s.data.formats.map((f) => <li class="chip">{f}</li>)}
              </ul>
              <span class={`pill pill--${s.data.status}`}>
                {statusLabel[s.data.status]}
              </span>
            </div>

            <div class="unit__buy">
              {s.data.price && <span class="price">{s.data.price}</span>}
              {s.data.url ? (
                <a class="btn" href={s.data.url}>Open it</a>
              ) : (
                <a class="btn" href="#contact">Get told when it ships</a>
              )}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <hr class="thread" />

  <!-- ================= 02 LIBRARY ================= -->
  <section class="section" id="packs">
    <div class="wrap">
      <div class="stage">
        <span class="stage__pos">02</span>
        <span class="stage__name">Library</span>
        <span class="stage__line" aria-hidden="true"></span>
      </div>

      <div class="lib">
        <div class="lib__intro">
          <h2 class="h2">Horn<br />libraries</h2>
          <p class="lede">
            Seven brass packs, played and recorded in collaboration with{' '}
            <a class="ilink" href={PARTNER_URL}>MSXII Sound</a>. They live over at
            Drew's Studio, along with everything else.
          </p>
          <p class="lib__cta">
            <a class="btn btn--solid" href={PACKS_URL}>Browse the libraries</a>
          </p>
        </div>

        <ol class="lib__list" role="list">
          {packs.map((p) => (
            <li class="lib__item">
              <a href={p.data.url ?? PACKS_URL}>
                <span class="lib__name">{p.data.title}</span>
                <span class="lib__arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- ================= CONTACT ================= -->
  <section class="section contact" id="contact">
    <div class="wrap contact__in">
      <p class="label label--hot">Output</p>
      <h2 class="display contact__h">Send us<br />something loud</h2>
      <p class="lede">
        Licensing, session work, a bug in the metronome, or first dibs on
        Valvetrain — it all arrives in the same inbox.
      </p>
      <a class="contact__mail" href="mailto:hello@lokiru.io">hello@lokiru.io</a>
    </div>

    <!-- Closing signature: the mark, woven from the cloth it came from. -->
    <p class="monogram" aria-hidden="true">LKRU</p>
  </section>
</Base>

<style>
  /* ---------------- hero ---------------- */
  .hero {
    position: relative;
    overflow: hidden;
    min-height: clamp(34rem, 88svh, 54rem);
    display: flex;
    align-items: center;
  }
  .hero__in { position: relative; z-index: 2; padding-block: clamp(5rem, 14vh, 9rem); }

  .hero__h {
    font-size: clamp(2.625rem, 1rem + 7.4vw, 7.25rem);
    font-variation-settings: 'wdth' 122, 'wght' 900;
    margin: 1.25rem 0 0;
  }
  .hero__h-alt {
    background: linear-gradient(92deg, var(--scarlet), var(--ember) 45%, var(--yellow));
    -webkit-background-clip: text;
            background-clip: text;
    color: transparent;
  }

  .hero__lede { margin-top: clamp(1.25rem, 3vw, 1.9rem); max-width: 44ch; }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: clamp(2rem, 5vw, 3rem);
  }

  /* ---------------- shared ---------------- */
  .head {
    display: grid;
    gap: clamp(1.25rem, 4vw, 3rem);
    align-items: end;
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }
  @media (min-width: 52rem) {
    .head { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  }

  .price {
    font-family: var(--mono);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--yellow);
  }

  .ilink { color: var(--yellow); text-decoration-color: var(--line-hot); }
  .ilink:hover { text-decoration-color: var(--yellow); }

  /* ---------------- 01 rack ---------------- */
  .rack__wrap { position: relative; z-index: 2; }

  .rack { list-style: none; margin: 0; padding: 0; display: grid; gap: 1px; background: var(--line); }

  .unit {
    background: var(--void-2);
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
    display: grid;
    gap: 1.5rem;
    align-items: center;
    transition: background 200ms ease;
  }
  .unit:hover { background: var(--panel); }
  @media (min-width: 62rem) {
    .unit {
      grid-template-columns: 14rem minmax(0, 1fr) auto auto;
      gap: 2.5rem;
    }
  }

  .unit__id .label { margin-bottom: 0.4rem; }
  .unit__title {
    font-family: var(--display);
    font-variation-settings: 'wdth' 114, 'wght' 800;
    font-size: clamp(1.75rem, 1.2rem + 1.6vw, 2.5rem);
    line-height: 0.95;
    text-transform: uppercase;
    letter-spacing: -0.015em;
    margin: 0;
  }

  .unit__mid { display: grid; gap: 0.9rem; }
  .unit__blurb { margin: 0; color: var(--ash); max-width: 46ch; }

  /* The parts of a suite, listed as the panel would list them. */
  .modules {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
  }
  .modules li {
    position: relative;
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--bone);
    padding-left: 0.85rem;
  }
  .modules li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 5px;
    height: 5px;
    background: var(--ember);
  }

  .unit__specs { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
  .chips { list-style: none; display: flex; flex-wrap: wrap; gap: 0.35rem; margin: 0; padding: 0; }
  .chip {
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    color: var(--ash);
    border: 1px solid var(--line);
    padding: 0.2rem 0.5rem;
  }

  .pill {
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.25rem 0.55rem;
    border: 1px solid currentColor;
    white-space: nowrap;
  }
  .pill--available { color: var(--yellow); }
  .pill--beta      { color: var(--cobalt); }
  .pill--soon      { color: var(--ash-dim); }

  .unit__buy { display: flex; align-items: center; gap: 1.25rem; }

  /* ---------------- 02 library ---------------- */
  .lib { display: grid; gap: clamp(2.5rem, 6vw, 4.5rem); }
  @media (min-width: 56rem) {
    .lib { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: start; }
  }
  .lib__cta { margin: clamp(1.75rem, 4vw, 2.5rem) 0 0; }

  .lib__list { list-style: none; margin: 0; padding: 0; counter-reset: lib; }
  .lib__item { counter-increment: lib; border-top: 1px solid var(--line); }
  .lib__item:last-child { border-bottom: 1px solid var(--line); }

  .lib__item a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-block: clamp(0.9rem, 2.2vw, 1.15rem);
    text-decoration: none;
    transition: color 160ms ease;
  }
  .lib__item a::before {
    content: counter(lib, decimal-leading-zero);
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    color: var(--ash-dim);
    flex: none;
  }
  .lib__name {
    font-family: var(--display);
    font-variation-settings: 'wdth' 106, 'wght' 700;
    font-size: clamp(1.0625rem, 0.9rem + 0.6vw, 1.3125rem);
    text-transform: uppercase;
    letter-spacing: -0.005em;
    flex: 1;
  }
  .lib__arrow {
    font-family: var(--mono);
    color: var(--ash-dim);
    transition: transform 200ms ease, color 200ms ease;
  }
  .lib__item a:hover { color: var(--yellow); }
  .lib__item a:hover .lib__arrow { color: var(--yellow); transform: translateX(4px); }

  /* ---------------- contact ---------------- */
  .contact { position: relative; overflow: hidden; }
  .contact__in { position: relative; z-index: 2; }
  .contact__h {
    font-size: clamp(2.5rem, 1.2rem + 7vw, 6rem);
    font-variation-settings: 'wdth' 120, 'wght' 900;
    margin: 1rem 0 1.75rem;
  }
  .contact__mail {
    display: inline-block;
    margin-top: 2rem;
    font-family: var(--mono);
    font-size: clamp(1rem, 0.85rem + 0.9vw, 1.5rem);
    color: var(--yellow);
    text-decoration: none;
    border-bottom: 1px solid var(--line-hot);
    padding-bottom: 0.35rem;
    transition: border-color 180ms ease, color 180ms ease;
  }
  .contact__mail:hover { color: var(--bone); border-color: var(--yellow); }

  .monogram {
    margin: clamp(2.5rem, 7vw, 4rem) 0 -0.16em;
    font-family: var(--display);
    font-variation-settings: 'wdth' 125, 'wght' 900;
    font-size: clamp(5rem, 21vw, 20rem);
    line-height: 0.78;
    letter-spacing: 0.02em;
    text-align: center;
    user-select: none;
    background-color: var(--scarlet);
    background-image:
      repeating-linear-gradient(90deg,
        rgba(0,0,0,0.55) 0 6px, transparent 6px 34px,
        rgba(238,204,0,0.9) 34px 38px, transparent 38px 52px,
        rgba(28,111,208,0.85) 52px 55px, transparent 55px 96px),
      repeating-linear-gradient(0deg,
        rgba(0,0,0,0.55) 0 6px, transparent 6px 34px,
        rgba(233,95,24,0.85) 34px 40px, transparent 40px 52px,
        rgba(28,111,208,0.7) 52px 55px, transparent 55px 96px);
    -webkit-background-clip: text;
            background-clip: text;
    color: transparent;
  }
</style>
