---
const links = [
  { href: '/#software', label: 'Software' },
  { href: '/#packs',    label: 'Libraries' },
  { href: '/#contact',  label: 'Contact' },
];
---

<header class="rail">
  <div class="rail__in wrap">
    <a class="mark" href="/" aria-label="Lokiru — home">
      <span class="mark__led" aria-hidden="true"></span>
      <span class="mark__word">LKRU</span>
    </a>

    <nav class="nav" aria-label="Primary">
      {links.map((l) => (
        <a class="nav__a" href={l.href}>{l.label}</a>
      ))}
    </nav>
  </div>
</header>

<style>
  .rail {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--void) 82%, transparent);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line);
  }
  .rail__in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 4rem;
  }

  .mark {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
  }
  /* Power LED — the only thing on the page that blinks on its own. */
  .mark__led {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--scarlet);
    box-shadow: 0 0 10px 1px var(--scarlet);
    animation: pulse 3.2s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50%      { opacity: 0.35; }
  }
  .mark__word {
    font-family: var(--display);
    font-variation-settings: 'wdth' 125, 'wght' 900;
    font-size: 1.1875rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--bone);
  }

  .nav { display: flex; align-items: center; gap: clamp(0.9rem, 3vw, 2rem); }
  .nav__a {
    font-family: var(--mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ash);
    text-decoration: none;
    padding-block: 0.4rem;
    transition: color 160ms ease;
  }
  .nav__a:hover { color: var(--phosphor); }

  @media (max-width: 30rem) {
    .nav__a:last-child { display: none; }
  }
</style>
